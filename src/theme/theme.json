{
  "colors": {
    "accent": {
      "light": "#74b49b",
      "main": "#58a18f",
      "highContrast": "#6db89f",
      "dark": "#3a7d6a"
    },
    "neutral": {
      "white": "#ffffff",
      "black": "#0a0a0a",
      "lightGrey": "#e8e8e8",
      "grey": "#9e9e9e",
      "darkGrey": "#1a1a1a"
    },
    "background": "#111111",
    "surface": "#1a1a1a",
    "border": "rgba(255, 255, 255, 0.08)",
    "semantic": {
      "cardBackground": "rgba(69, 77, 93, 0.15)",
      "cardBackgroundHighlight": "rgba(69, 77, 93, 0.25)",
      "cardBorder": "rgba(255, 255, 255, 0.08)",
      "cardBorderHighlight": "rgba(255, 255, 255, 0.12)",
      "cardBorderHover": "rgba(255, 255, 255, 0.2)",
      "tagBorder": "rgba(255, 255, 255, 0.15)",
      "tagBorderHover": "rgba(255, 255, 255, 0.25)",
      "tagBackground": "rgba(255, 255, 255, 0.05)",
      "tagBackgroundHover": "rgba(255, 255, 255, 0.1)",
      "navActiveBackground": "rgba(255, 255, 255, 0.08)",
      "navHoverBackground": "rgba(255, 255, 255, 0.05)",
      "navbarBackdrop": "rgba(17, 17, 17, 0.8)",
      "divider": "rgba(255, 255, 255, 0.08)",
      "accentBorder": "rgba(88, 161, 143, 0.4)",
      "accentBackgroundHover": "rgba(88, 161, 143, 0.1)"
    }
  },
  "font": {
    "primary": {
      "fontFamily": "'Inter', 'Helvetica Neue', Arial, sans-serif"
    },
    "secondary": {
      "fontFamily": "'Inter', 'Helvetica Neue', Arial, sans-serif"
    },
    "weight": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "bold": 700
    },
    "fontSize": "1rem",
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.02em",
      "wider": "0.05em"
    },
    "headings": {
      "h1": {
        "fontSize": "3.5rem",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.03em"
      },
      "h2": {
        "fontSize": "2rem",
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h3": {
        "fontSize": "1.25rem",
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      }
    },
    "body": {
      "fontSize": "1rem",
      "fontWeight": 400,
      "lineHeight": 1.6,
      "letterSpacing": "0"
    },
    "tagText": {
      "fontSize": "0.8125rem",
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "0.02em"
    },
    "navText": {
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.6,
      "letterSpacing": "0"
    },
    "small": {
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "0"
    },
    "icons": {
      "fontSize": "1.25rem"
    }
  },
  "spacing": {
    "xxs": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "80px"
  },
  "responsive": {
    "smallMobileDevices": "480px"
  },
  "media": {
    "tablet": "@media (min-width: 768px)",
    "desktop": "@media (min-width: 1024px)"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "pill": "100px"
  },
  "transition": {
    "fast": "0.15s ease",
    "normal": "0.2s ease",
    "slow": "0.3s ease",
    "boxShadow": "0.4s ease"
  },
  "maxWidth": {
    "content": "720px",
    "hero": "960px",
    "about": "560px"
  },
  "animation": {
    "ringSpinDuration": "8s",
    "floatDuration": "6s",
    "glowColor": "rgba(88, 161, 143, 0.15)",
    "glowColorHover": "rgba(88, 161, 143, 0.25)"
  },
  "boxShadow": {
    "cardHover": "0 8px 30px rgba(88, 161, 143, 0.15)",
    "cardHighlight": "0 0 20px rgba(88, 161, 143, 0.1)",
    "cardHighlightHover": "0 8px 30px rgba(88, 161, 143, 0.2)",
    "tagHover": "0 2px 8px rgba(88, 161, 143, 0.1)",
    "contactHover": "0 8px 24px rgba(88, 161, 143, 0.15)",
    "iconGlow": "drop-shadow(0 0 8px rgba(88, 161, 143, 0.4))",
    "modalOverlay": "rgba(0, 0, 0, 0.85)"
  }
}
